<odoo>
    <data>

        <record id="view_remote_picking_label_tree" model="ir.ui.view">
            <field name="name">remote.picking.label.tree</field>
            <field name="model">remote.picking.label</field>
            <field name="arch" type="xml">
                <tree string="Etiquetas ZPL generadas">
                    <field name="create_date"/>
                    <field name="connection_id"/>
                    <field name="sale_order_name"/>
                    <field name="picking_name"/>
                    <field name="product_name"/>
                    <field name="qty"/>
                    <field name="printed"/>
                    <field name="state"/>
                    <button name="action_copy_notice"
                            type="object"
                            string="Copiar ZPL"
                            class="btn-primary"
                            icon="fa-clipboard"/>
                </tree>
            </field>
        </record>

        <record id="view_remote_picking_label_form" model="ir.ui.view">
            <field name="name">remote.picking.label.form</field>
            <field name="model">remote.picking.label</field>
            <field name="arch" type="xml">
                <form string="Etiqueta ZPL generada">
                    <sheet>
                        <group>
                            <field name="connection_id" readonly="1"/>
                            <field name="sale_order_name" readonly="1"/>
                            <field name="picking_name" readonly="1"/>
                            <field name="product_name" readonly="1"/>
                            <field name="qty" readonly="1"/>
                            <field name="printed"/>
                            <field name="state"/>
                        </group>
                        <group string="Información remota" col="4">
                            <field name="picking_id_remote" readonly="1"/>
                            <field name="product_id_remote" readonly="1"/>
                        </group>
                        <group string="Etiqueta ZPL">
                            <field name="zpl_text" widget="text" nolabel="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Copiar etiqueta ZPL"
                                type="object"
                                name="action_copy_notice"
                                class="btn-primary"/>
                        <button string="Cerrar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_remote_picking_label" model="ir.actions.act_window">
            <field name="name">Etiquetas dinámicas</field>
            <field name="res_model">remote.picking.label</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="action_generate_and_open_labels" model="ir.actions.server">
            <field name="name">Generar etiquetas dinámicas</field>
            <field name="model_id" ref="remote_picking_zpl.model_remote_odoo_connection"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
action = env['remote.odoo.connection']._generate_labels_and_get_action()
            ]]></field>
        </record>

        <menuitem id="menu_remote_picking_label"
                  name="Etiquetas dinámicas"
                  parent="menu_remote_picking_root"
                  action="action_generate_and_open_labels"
                  sequence="30"/>
    </data>
</odoo>
